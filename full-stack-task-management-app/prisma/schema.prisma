generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String?  @unique
  password  String?  // For auth (or use NextAuth providers)
  boards    Board[]  // Users own boards
}

model Board {
  id        String   @id @default(uuid())
  title     String
  userId    String
  lists     List[]
  user      User     @relation(fields: [userId], references: [id])
}

model List {
  id        String   @id @default(uuid())
  title     String
  order     Int      // For sorting lists
  boardId   String
  cards     Card[]
  board     Board    @relation(fields: [boardId], references: [id])
}

model Card {
  id        String   @id @default(uuid())
  title     String
  description String?
  order     Int      // For sorting cards within list
  listId    String
  list      List     @relation(fields: [listId], references: [id])
}